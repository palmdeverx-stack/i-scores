# Server-side PIN required after password authentication for master administrators.
# Must contain exactly 8 digits.
MASTER_ADMIN_PIN=12345678

# External Marketplace website shown to teachers and administrators.
NEXT_PUBLIC_MARKETPLACE_URL=

# OAuth 2.0 Web client ID used by Google Identity Services on sign-in/sign-up pages.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Resend (resend.com) — sends the school-admin invite email when a master
# admin creates a new school. Get RESEND_API_KEY from the Resend dashboard.
# RESEND_FROM_EMAIL must be an address on a domain verified with Resend;
# falls back to onboarding@resend.dev (sandbox-only) if unset.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Shared bearer secret used only by Marketplace server-to-server provisioning.
# Generate a long random value and configure the same value in Marketplace.
MARKETPLACE_PROVISION_SECRET=
MARKETPLACE_SSO_SECRET=
